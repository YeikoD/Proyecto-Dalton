<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Interfaz/Styles.uss?fileID=7433441132597879392&amp;guid=7361bee60b6da7744934742e9be2c000&amp;type=3#Styles"/>
    <ui:VisualElement name="TooltipRaiz" class="tooltip-panel panel-base panel--hidden">
        <ui:VisualElement class="tooltip__cabecera">
            <ui:VisualElement name="SimboloBox" class="tooltip__simbolo-box"/>
            <ui:VisualElement class="tooltip__info-basica">
                <ui:Label name="NombreElemento" text="HIDRÓGENO" class="text-base text-bold tooltip__nombre"/>
                <ui:Label name="SimboloElemento" text="Elemento: H" class="text-base tooltip__simbolo-identidad"/>
                <ui:Label name="MasaBaseElemento" text="Masa: 1.0u" class="text-base tooltip__simbolo-identidad"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FilaCompuestoDalton" class="tooltip__dato-fila" style="display: none; margin-top: 10px; margin-bottom: 5px;">
            <ui:VisualElement name="IconoCompuestoDalton" class="tooltip__dato-icono icono-dalton"/>
            <ui:Label name="LabelCompuestoDalton" text="Compuesto: -" class="text-base tooltip__dato-dinamico tooltip__label-dalton"/>
        </ui:VisualElement>
        <ui:VisualElement class="tooltip__subtitulo-container">
            <ui:Label name="TituloTeoria" text="TEORÍA" class="tooltip__subtitulo"/>
            <ui:VisualElement name="LineTeoria" class="tooltip__subtitulo-linea"/>
        </ui:VisualElement>
        <ui:Label name="DescripcionTeorica" text="..." class="tooltip__descripcion"/>
        <ui:VisualElement class="tooltip__subtitulo-container">
            <ui:Label name="TituloObservaciones" text="OBSERVACIONES" class="tooltip__subtitulo"/>
            <ui:VisualElement name="LineObservaciones" class="tooltip__subtitulo-linea"/>
        </ui:VisualElement>
        <ui:VisualElement class="tooltip__info-dinamica">
            <ui:VisualElement class="tooltip__dato-fila">
                <ui:VisualElement class="tooltip__dato-icono icono-balance"/>
                <ui:Label name="MasaElemento" text="Masa Total: 1.0u" class="text-base tooltip__dato-dinamico"/>
            </ui:VisualElement>
            <ui:VisualElement class="tooltip__dato-fila">
                <ui:VisualElement class="tooltip__dato-icono icono-ciencia"/>
                <ui:Label name="FormulaQuimica" text="Fórmula: H2" class="text-base tooltip__dato-dinamico"/>
            </ui:VisualElement>
            <ui:VisualElement class="tooltip__dato-fila">
                <ui:VisualElement class="tooltip__dato-icono icono-composicion"/>
                <ui:Label name="ComposicionMasa" text="H: 100%" class="text-base tooltip__dato-dinamico"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterClasificacion" class="tooltip__footer">
            <ui:VisualElement class="tooltip__footer-icono"/>
            <ui:VisualElement class="tooltip__footer-info">
                <ui:Label text="CLASIFICACIÓN ORIGINAL" class="tooltip__footer-titulo"/>
                <ui:Label text="DALTON - 1803" class="tooltip__footer-subtitulo"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ConsolaRaiz" class="console-container panel-base panel--hidden">
        <ui:VisualElement class="console__header">
            <ui:Label text="REGISTRO DE EVENTOS" class="console__titulo"/>
            <ui:Label text="• EN VIVO" class="console__status"/>
        </ui:VisualElement>
        <ui:VisualElement class="console__separador"/>
        <ui:ScrollView name="ContenedorMensajes" class="console-scroll"/>
    </ui:VisualElement>
    <ui:VisualElement name="MenuRaiz" class="menu-derecho panel-base panel--hidden-right" style="display: none;">
        <ui:VisualElement class="menu-derecho__cabecera">
            <ui:Label text="SELECCIÓN DE ELEMENTOS" class="text-base text-bold menu-derecho__titulo" style="-unity-font-definition: url(&quot;project://database/Assets/Interfaz/Fuentes/Roboto-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=6cb56dc8fcb4ab9469665128883f9b26&amp;type=3#Roboto-VariableFont_wdth,wght&quot;);"/>
            <ui:Button name="BotonCerrarMenu" class="boton-base boton-cerrar"/>
        </ui:VisualElement>
        <ui:ScrollView name="ListaAtomos" class="console-scroll"/>
    </ui:VisualElement>

    <ui:VisualElement name="MenuPrincipalRaiz" class="menu-principal-pantalla">
        <ui:Button name="BotonAjustes" class="boton-base boton-ajustes boton-ajustes--hidden" style="display: none;"/>
        <ui:VisualElement class="menu-principal__contenedor">
            <ui:VisualElement class="titulo-logo titulo-logo--hidden" style="display: none;"/>
            <ui:Button name="BotonIniciar" text="INICIAR SIMULACIÓN" class="boton-base boton-iniciar boton-iniciar--hidden" style="display: none;"/>
            <ui:Button name="BotonVolver" text="VOLVER A LA SIMULACIÓN" class="boton-base boton-iniciar boton-iniciar--hidden" style="display: none;"/>
            <ui:Button name="BotonLimpiar" text="LIMPIAR ESCENA" class="boton-base boton-iniciar boton-iniciar--hidden boton-limpiar" style="display: none;"/>
            <ui:Button name="BotonSalir" text="SALIR DEL SIMULADOR" class="boton-base boton-iniciar boton-iniciar--hidden boton-salir" style="display: none;"/>
        </ui:VisualElement>
        <ui:Label text="Developed by Anderson Correa" class="texto-creditos texto-creditos--hidden" style="display: none;"/>
        <ui:VisualElement class="cuadro-informacion cuadro-informacion--hidden" style="display: none;">
            <ui:Label text="Proyecto de Química" class="info-label info-label--bold"/>
            <ui:Label text="Liceo Nº 45 - Victor Bersanelli" class="info-label"/>
            <ui:Label text="MODULO 3-3 - Plan 2009" class="info-label"/>
            <ui:Label text="Prof: Federico Rodrigues" class="info-label"/>
        </ui:VisualElement>
        <ui:VisualElement class="logos-contenedor logos-contenedor--hidden" style="display: none;">
            <ui:VisualElement name="LogoCompania" class="logo-icon logo-compania"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="NotificacionRaiz" class="notificacion-panel panel-base notificacion--hidden">
        <ui:VisualElement class="notificacion__icono-contenedor">
            <ui:VisualElement name="NotificacionIcono" class="notificacion__icono"/>
        </ui:VisualElement>
        <ui:VisualElement class="notificacion__contenido">
            <ui:Label name="NotificacionTitulo" text="¡NUEVO COMPUESTO!" class="text-base text-bold notificacion__titulo"/>
            <ui:VisualElement class="notificacion__separador"/>
            <ui:Label name="NotificacionMensaje" text="Se ha formado una nueva estructura molecular." class="text-base notificacion__mensaje"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="AjustesRaiz" class="ajustes-panel panel-base panel--hidden" style="display: none;">
        <ui:VisualElement class="ajustes__cabecera">
            <ui:Label text="CONFIGURACIÓN DEL SISTEMA" class="text-base text-bold ajustes__titulo"/>
            <ui:Button name="BotonCerrarAjustes" class="boton-base boton-cerrar"/>
        </ui:VisualElement>
        <ui:ScrollView name="ContenedorAjustes" class="ajustes__contenido">
            <ui:VisualElement class="ajustes__seccion-header">
                <ui:Label text="INTERFAZ" class="ajustes__subtitulo"/>
                <ui:VisualElement class="ajustes__subtitulo-linea"/>
            </ui:VisualElement>
            <ui:VisualElement class="ajustes__fila">
                <ui:Label text="ESCALA DE INTERFAZ (PANELES)" class="text-base ajustes__label"/>
                <ui:Slider name="SliderEscalaPaneles" low-value="1" high-value="1.8" value="1" class="ajustes__slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="ajustes__fila">
                <ui:Label text="ESCALA DE INTERFAZ (TEXTO)" class="text-base ajustes__label"/>
                <ui:Slider name="SliderEscalaTexto" low-value="1" high-value="1.8" value="1" class="ajustes__slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="ajustes__fila">
                <ui:Label text="ESCALA DE INTERFAZ (ICONOS)" class="text-base ajustes__label"/>
                <ui:Slider name="SliderEscalaIconos" low-value="1" high-value="1.8" value="1" class="ajustes__slider"/>
            </ui:VisualElement>

            <ui:VisualElement class="ajustes__seccion-header" style="margin-top: 15px;">
                <ui:Label text="AUDIO" class="ajustes__subtitulo"/>
                <ui:VisualElement class="ajustes__subtitulo-linea"/>
            </ui:VisualElement>
            <ui:VisualElement class="ajustes__fila">
                <ui:Label text="VOLUMEN DE ÁTOMOS" class="text-base ajustes__label"/>
                <ui:Slider name="SliderVolumenAtomos" low-value="0" high-value="1" value="0.5" class="ajustes__slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="ajustes__fila">
                <ui:Label text="VOLUMEN DE INTERFAZ" class="text-base ajustes__label"/>
                <ui:Slider name="SliderVolumenUI" low-value="0" high-value="1" value="0.8" class="ajustes__slider"/>
            </ui:VisualElement>
            <!-- Más ajustes aquí en el futuro -->
        </ui:ScrollView>
    </ui:VisualElement>

    <ui:VisualElement name="InformacionRaiz" class="informacion-panel panel-base panel--hidden" style="display: none;">
        <ui:VisualElement class="informacion__cabecera">
            <ui:Label text="INFORMACIÓN DEL PROYECTO" class="text-base text-bold informacion__titulo"/>
            <ui:Button name="BotonCerrarInfo" class="boton-base boton-cerrar"/>
        </ui:VisualElement>
        <ui:VisualElement class="informacion__separador"/>
        <ui:ScrollView name="ContenedorInfo" class="informacion__contenido">
            <ui:VisualElement name="ContenedorGridCompuestos" class="informacion__grid"/>
        </ui:ScrollView>
    </ui:VisualElement>

    <ui:VisualElement name="HotbarRaiz" class="hotbar-contenedor panel-base hotbar--hidden" style="display: none;">
        <ui:Button name="HotbarBotonSelector" tooltip="Selector de Átomos" class="hotbar-boton">
            <ui:VisualElement class="hotbar__icono icono-selector"/>
        </ui:Button>
        <ui:Button name="HotbarBotonLimpiar" tooltip="Limpiar Escena" class="hotbar-boton">
            <ui:VisualElement class="hotbar__icono icono-limpiar"/>
        </ui:Button>
        <ui:Button name="HotbarBotonInfo" tooltip="Información" class="hotbar-boton">
            <ui:VisualElement class="hotbar__icono icono-info"/>
        </ui:Button>
        <ui:Button name="HotbarBotonAjustes" tooltip="Configuración" class="hotbar-boton">
            <ui:VisualElement class="hotbar__icono icono-ajustes"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
