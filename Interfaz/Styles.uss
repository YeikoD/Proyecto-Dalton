:root {
    /* --- Colores --- */
    --color-bg-panel: rgba(0, 0, 0, 0.25);
    --color-border-light: rgba(0, 50, 110, 0.5);
    --color-accent-primary: rgb(0, 50, 110);
    /* Dorado por defecto */
    --color-accent-secondary: #7D1C34;
    --color-accent-secondary-alt: #9E2D47;
    --color-accent-tertiary: #398084;
    --color-accent-tertiary-alt: #4CA6AB;
    --color-text-main: rgb(220, 220, 220);
    --color-text-secondary: rgba(255, 255, 255, 0.9);
    --color-text-highlight: rgb(157, 193, 215);
    --spacing-main: 10px;
    --radius-main: 12px;
    /* --- Tipografía --- */
    --font-primary: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
    --font-secondary: url("project:/Assets/Interfaz/Fuentes/Roboto-VariableFont_wdth,wght.ttf");
    --size-body: 12px;
    --size-h1: 20px;
    --size-h2: 18px;
    --size-h3: 16px;
    --opacity-common: 0.5;
    --opacity-subtle: 0.25;
    --font-size-common: 14px;
    --color-text-secondary: rgba(255, 255, 255, 0.9);
    -unity-font-definition: var(--font-secondary);

    /* --- Bordes --- */
    --border-width-main: 1px;
    --border-width-heavy: 2px;
}

.panel-base {
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-main);
    padding: var(--spacing-main);
    border-width: var(--border-width-main);
    border-color: var(--color-border-light);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
}

.panel--hidden {
    opacity: 0;
    translate: -30px 0;
}

.panel--hidden-right {
    opacity: 0;
    translate: 30px 0;
}

.panel-accent-left {
    border-left-width: 4px;
    border-left-color: var(--color-accent-primary);
}



.panel-accent-bottom {
    border-bottom-width: 4px;
    border-bottom-color: var(--color-accent-primary);
}


.text-base {
    color: var(--color-text-main);
    font-size: var(--size-body);
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
}

.text-bold {
    -unity-font-style: bold;
}

.console-container {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 400px;
    height: 180px;
    padding: 12px;
}

.console__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.console__titulo {
    font-size: 13px;
    color: var(--color-text-highlight);
    -unity-font-style: bold;
    -unity-font-definition: var(--font-secondary);
    letter-spacing: 1px;
}

.console__status {
    font-size: 10px;
    color: var(--color-text-highlight);
    -unity-font-definition: var(--font-secondary);
    opacity: 0.8;
}

.console__separador {
    height: 1px;
    background-color: var(--color-border-light);
    margin-bottom: 8px;
}

.console-scroll {
    flex-grow: 1;
}

.console-scroll .unity-scroller {
    width: 0;
    opacity: 0;
    display: none;
}

.menu-derecho {
    position: absolute;
    right: 20px;
    top: 15%;
    height: 70%;
    width: 276px;
    padding: 10px;
}

#ListaAtomos #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 5px;
}



.menu-derecho__cabecera {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    border-bottom-width: var(--border-width-main);
    border-bottom-color: var(--color-border-light);
    padding-bottom: 5px;
}

.menu-derecho__titulo {
    font-size: 13px;
    color: var(--color-text-highlight);
    -unity-font-style: bold;
    -unity-font-definition: var(--font-secondary);
    letter-spacing: 1px;
    margin-bottom: 0;
}

.boton-base {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-accent-primary);
    color: var(--color-text-main);
    font-size: var(--size-body);
    letter-spacing: 1px;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
    padding: 8px 12px;
    border-radius: var(--radius-main);
    transition-property: background-color, border-color, opacity, scale, translate;
    transition-duration: 0.3s;
    justify-content: center;
    align-items: center;
}

.boton-base:hover {
    background-color: var(--color-border-light);
    border-color: var(--color-text-highlight);
    scale: 1.05;
    translate: 0 -3px;
}

.boton-base:active {
    scale: 0.95;
    background-color: rgba(0, 50, 110, 0.1);
}

/* Botón cerrar (X) */
.boton-base.boton-cerrar {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-main);
    font-size: 16px;
    -unity-font-style: bold;
    padding: 5px;
}

.boton-base.boton-cerrar:hover {
    color: var(--color-accent-secondary);
}

.tooltip-panel {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 325px;
    padding: 17px;
    min-height: 600px;
    display: flex;
}

.tooltip__cabecera {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.tooltip__simbolo-box {
    width: 90px;
    height: 90px;
    justify-content: center;
    align-items: center;
    margin-right: 15px;
}

.tooltip__simbolo-texto {
    font-size: 20px;
    color: white;
}

.tooltip__nombre {
    font-size: 24px;
    margin: 0;
    margin-bottom: -2px;
    -unity-font-style: bold;
    -unity-font-definition: var(--font-secondary);
}

.tooltip__masa {
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    margin: 0;
    margin-bottom: 0;
}

.tooltip__simbolo-identidad {
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    margin: 0;
    margin-bottom: -2px;
}

.tooltip__info-basica {
    flex-grow: 1;
}

.tooltip__subtitulo-container {
    flex-direction: row;
    align-items: center;
    margin-top: 25px;
    margin-bottom: 8px;
}

.tooltip__subtitulo {
    font-size: 13px;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
    color: var(--color-accent-primary);
    letter-spacing: 2px;
}

.tooltip__subtitulo-linea {
    flex-grow: 1;
    height: 1px;
    background-color: var(--color-accent-primary);
    margin-left: 10px;
    opacity: 0.6;
}

.tooltip__formula {
    font-size: 14px;
    margin-top: 2px;
}



/* --- Layout de Datos con Iconos --- */
.tooltip__dato-fila {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 16px;
}

.tooltip__dato-icono {
    width: 36px;
    height: 36px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-accent-primary);
    flex-shrink: 0;
}

.icono-balance {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/DetallesAtomo/balance_256dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
}

.icono-ciencia {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/DetallesAtomo/bubble_chart_256dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
}

.icono-composicion {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/DetallesAtomo/experiment_256dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
}

.tooltip__dato-dinamico {
    margin-bottom: 0;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    white-space: normal;
    flex-shrink: 1;
    opacity: var(--opacity-common);
}


.tooltip__descripcion {
    padding-top: 5px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

.tooltip__nota {
    padding-top: 5px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

/* --- Footer: Clasificación --- */
.tooltip__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 15px;
    padding: 9px 15px;
    border-width: var(--border-width-main);
    border-color: var(--color-accent-primary);
    background-color: transparent;
    border-radius: var(--radius-main);
}

.tooltip__footer-icono {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/LogoSimulador_icono.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: var(--opacity-common);
}

.tooltip__footer-info {
    flex-grow: 1;
}

.tooltip__footer-titulo {
    font-size: 14px;
    color: var(--color-text-highlight);
    opacity: 0.7;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.tooltip__footer-subtitulo {
    font-size: 14px;
    color: white;
    opacity: var(--opacity-subtle);
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
    margin-top: 5px;
}

.boton-base.boton-atomo__borrar {
    width: 26px;
    height: 26px;
    background-color: var(--color-accent-secondary);
    color: rgba(255, 255, 255, 0.8);
    border-radius: 13px;
    border-width: var(--border-width-main);
    border-color: var(--color-accent-secondary-alt);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s;
    margin-left: 10px;
}

.boton-base.boton-atomo__borrar:hover {
    background-color: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary-alt);
    color: white;
    scale: 1.15;
}

/* --- DISEÑO DE INVENTARIO DE ÁTOMOS --- */
.boton-atomo {
    width: 110px;
    height: 125px;
    margin: 6px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-accent-primary);
    border-radius: var(--radius-main);
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    padding: 8px;
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.3s;
}

.boton-atomo:hover {
    background-color: transparent;
    border-color: var(--color-text-highlight);
    scale: 1.08;
    translate: 0 -2px;
}

.boton-atomo__icono {
    width: 64px;
    height: 64px;
    margin-bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.boton-atomo__texto {
    font-size: 11px;
    letter-spacing: 1px;
    opacity: 0.9;
    -unity-text-align: middle-center;
    white-space: normal;
    height: 30px;
}

.boton-atomo__borrar {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.5);
    color: var(--color-accent-secondary-alt);
    border-radius: 9px;
    font-size: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity, background-color;
    transition-duration: 0.2s;
}

.boton-atomo:hover .boton-atomo__borrar {
    opacity: 1;
}

.boton-atomo__borrar:hover {
    background-color: var(--color-accent-secondary);
    color: white;
}

.console-label {
    margin-bottom: 4px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: 1.0;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
}

.console-label--important {
    color: var(--color-accent-tertiary);
}

.border-light {
    position: absolute;
    border-radius: 1px;
}

/* --- MENÚ PRINCIPAL --- */
.menu-principal-pantalla {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    justify-content: center;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.boton-base.boton-ajustes {
    position: absolute;
    top: 5px;
    left: 5px;
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-width: 0;
    opacity: var(--opacity-common);
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/UI/settings_200dp_E3E3E3_FILL0_wght100_GRAD200_small.png");
    transition-property: opacity, rotate, scale;
    transition-duration: 0.4s;
}

.boton-base.boton-ajustes--hidden {
    opacity: 0;
    scale: 0;
}

.boton-base.boton-ajustes:hover {
    opacity: 1;
    rotate: 45deg;
    scale: 1.1;
}

.menu-principal--hidden {
    opacity: 0;
    scale: 1.1;
}

.menu-principal__contenedor {
    align-items: center;
}

.titulo-logo {
    width: 1000px;
    height: 333px;
    margin-bottom: 20px;
    background-image: url("project:/Assets/Interfaz/Iconos/LogoSimulador_medio_grande.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 2s;
    transition-timing-function: ease-out;
}

.titulo-logo--hidden {
    opacity: 0;
    scale: 0.8;
}

.cuadro-informacion {
    position: absolute;
    top: 25px;
    right: 25px;
    align-items: flex-end;
    padding-right: 15px;
    border-right-width: var(--border-width-heavy);
    border-right-color: var(--color-accent-primary);
    transition-property: opacity;
    transition-duration: 0.8s;
}

.cuadro-informacion--hidden {
    opacity: 0;
}

.info-label {
    font-size: 11px;
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    letter-spacing: 3px;
    margin-bottom: 2px;
    -unity-font-style: bold;
    -unity-font-definition: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
}

.info-label--bold {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-highlight);
    margin-bottom: 5px;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.boton-base.boton-iniciar {
    width: 322px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 14px;
    letter-spacing: 3px;
    border-color: var(--color-accent-primary);
}

.boton-base.boton-salir {
    margin-top: 15px;
    border-color: var(--color-accent-secondary);
}

.boton-base.boton-salir:hover {
    background-color: rgba(125, 28, 52, 0.5);
    border-color: var(--color-accent-secondary-alt);
    color: white;
}

.boton-base.boton-limpiar {
    margin-top: 10px;
}

.logos-contenedor {
    position: absolute;
    bottom: 10px;
    right: -20px;
    flex-direction: row;
    align-items: center;
    transition-property: opacity;
    transition-duration: 1s;
}

.logos-contenedor--hidden {
    opacity: 0;
}

.logo-icon {
    width: 100px;
    height: 50px;
    opacity: var(--opacity-common);
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    -unity-background-scale-mode: scale-to-fit;
}

.logo-icon:hover {
    opacity: 1;
    scale: 1.1;
}

.logo-compania {
    background-image: url("project:/Assets/Interfaz/IMG/logo_yeiko_pequeno.png");
}

.texto-creditos {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 11px;
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-font-definition: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
    border-left-width: var(--border-width-heavy);
    border-left-color: var(--color-accent-primary);
    padding-left: 10px;
    transition-property: color, border-left-color, opacity;
    transition-duration: 0.3s;
}

.texto-creditos--hidden {
    opacity: 0;
}

.texto-creditos:hover {
    color: white;
    border-left-color: white;
}

/* --- PANELES CENTRALES (AJUSTES E INFORMACIÓN) --- */
.ajustes-panel,
.informacion-panel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 600px;
    height: 450px;
    translate: -50% -50%;
    padding: 20px;
}

.ajustes__cabecera,
.informacion__cabecera {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.ajustes__titulo,
.informacion__titulo {
    font-size: 14px;
    color: var(--color-text-highlight);
    letter-spacing: 2px;
}

.ajustes__separador,
.informacion__separador {
    height: 1px;
    background-color: var(--color-border-light);
    margin-bottom: 15px;
    opacity: 0.5;
}

.ajustes__contenido,
.informacion__contenido {
    flex-grow: 1;
}

.ajustes__fila {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.ajustes__label {
    font-size: 11px;
    opacity: 0.8;
    width: 40%;
}

.ajustes__slider {
    flex-grow: 1;
}

/* --- NOTIFICACIÓN LATERAL --- */
.notificacion-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 276px;
    flex-direction: row;
    padding: 4px 6px;
    border-width: var(--border-width-main);
    transition-property: translate, opacity, border-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}

.notificacion--hidden {
    opacity: 0;
    translate: 420px 0;
}

.notificacion__icono-contenedor {
    width: 64px;
    justify-content: center;
    align-items: center;
    margin-right: 8px;
    flex-shrink: 0;
}

.notificacion__icono {
    width: 56px;
    height: 56px;
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/UI/sensors_krx_256dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-accent-primary);
}

.notificacion__contenido {
    flex-grow: 1;
    justify-content: center;
}

.notificacion__titulo {
    font-size: 13px;
    color: var(--color-accent-primary);
    letter-spacing: 2px;
    margin-bottom: 2px;
    -unity-font-style: bold;
    transition-property: color;
    transition-duration: 0.3s;
}

.notificacion__separador {
    height: 1px;
    background-color: var(--color-accent-primary);
    margin-bottom: 3px;
    opacity: 0.3;
}



.notificacion__mensaje {
    font-size: 12px;
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    white-space: normal;
    -unity-text-align: middle-left;
}

/* --- HOTBAR (BARRA DE HERRAMIENTAS) --- */
.hotbar-contenedor {
    position: absolute;
    bottom: 20px;
    right: 20px;
    flex-direction: row;
    padding: 10px;
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-main);
    border-width: var(--border-width-main);
    border-color: var(--color-border-light);
    width: 276px;
    justify-content: space-between;
    overflow: visible !important;
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.4s;
}

.hotbar-contenedor:hover {
    scale: 1.02;
}

.hotbar-boton {
    width: 52px;
    height: 52px;
    margin: 2px;
    padding: 8px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-accent-primary);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, border-color, scale, translate;
    transition-duration: 0.3s;
}

.hotbar-boton:hover {
    background-color: transparent;
    border-color: var(--color-text-highlight);
    scale: 1.12;
    translate: 0 -3px;
}

.hotbar-boton:active {
    scale: 0.95;
    background-color: var(--color-accent-primary);
}

.hotbar__icono {
    width: 100%;
    height: 100%;
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/LogoSimulador_icono_small.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

/* Iconos específicos por botón */
#HotbarBotonSelector .hotbar__icono {
    -unity-background-image-tint-color: var(--color-text-secondary);
    opacity: 0.4;
}

#HotbarBotonLimpiar .hotbar__icono {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/UI/delete_200dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
    -unity-background-image-tint-color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

#HotbarBotonInfo .hotbar__icono {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/UI/book_5_200dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
    -unity-background-image-tint-color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

#HotbarBotonAjustes .hotbar__icono {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/UI/settings_200dp_E3E3E3_FILL0_wght100_GRAD200_opsz48.png");
    -unity-background-image-tint-color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

.hotbar-boton:hover .hotbar__icono {
    opacity: 1;
    -unity-background-image-tint-color: var(--color-text-highlight);
}

.hotbar--hidden {
    translate: 0 100px;
    opacity: 0;
}