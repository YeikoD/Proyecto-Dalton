:root {
    /* --- Colores --- */
    --color-bg-panel: rgba(0, 0, 0, 0.25);
    --color-border-light: rgba(0, 50, 110, 0.5);
    --color-accent-primary: rgb(0, 50, 110);
    /* Dorado por defecto */
    --color-accent-secondary: #7D1C34;
    --color-accent-secondary-alt: #9E2D47;
    --color-accent-tertiary: #398084;
    --color-accent-tertiary-alt: #4CA6AB;
    --color-text-main: rgb(220, 220, 220);
    --spacing-main: 10px;
    --radius-main: 12px;
    /* --- Tipografía --- */
    --font-primary: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
    --font-secondary: url("project:/Assets/Interfaz/Fuentes/Roboto-VariableFont_wdth,wght.ttf");
    --size-body: 12px;
    --size-h1: 20px;
    --size-h2: 18px;
    --size-h3: 16px;
    --opacity-common: 0.5;
    --opacity-subtle: 0.25;
    --font-size-common: 14px;
    --color-text-secondary: rgba(255, 255, 255, 0.9);
    -unity-font-definition: var(--font-secondary);
}

.panel-base {
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-main);
    padding: var(--spacing-main);
    border-width: 1px;
    border-color: var(--color-border-light);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
}

.panel--hidden {
    opacity: 0;
    translate: -30px 0;
}

.panel--hidden-right {
    opacity: 0;
    translate: 30px 0;
}

.panel-accent-left {
    border-left-width: 4px;
    border-left-color: var(--color-accent-primary);
}

.panel-base--fusion {
    border-color: var(--color-accent-tertiary) !important;
}

.panel-accent-left--fusion {
    border-left-color: var(--color-accent-tertiary) !important;
}

.panel-accent-bottom--fusion {
    border-bottom-color: var(--color-accent-tertiary) !important;
}

.panel-base--ruptura {
    border-color: var(--color-accent-secondary) !important;
}

.panel-accent-left--ruptura {
    border-left-color: var(--color-accent-secondary) !important;
}

.panel-accent-bottom--ruptura {
    border-bottom-color: var(--color-accent-secondary) !important;
}

.panel-accent-bottom {
    border-bottom-width: 4px;
    border-bottom-color: var(--color-accent-primary);
}


.text-base {
    color: var(--color-text-main);
    font-size: var(--size-body);
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
}

.text-bold {
    -unity-font-style: bold;
}

.console-container {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 400px;
    height: 180px;
    padding: 12px;
}

.console__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.console__titulo {
    font-size: 13px;
    color: rgb(157, 193, 215);
    -unity-font-style: bold;
    -unity-font-definition: var(--font-secondary);
    letter-spacing: 1px;
}

.console__status {
    font-size: 10px;
    color: rgb(157, 193, 215);
    -unity-font-definition: var(--font-secondary);
    opacity: 0.8;
}

.console__separador {
    height: 1px;
    background-color: var(--color-border-light);
    margin-bottom: 8px;
}

.console-scroll {
    flex-grow: 1;
}

.console-scroll .unity-scroller {
    width: 0;
    opacity: 0;
    display: none;
}

.menu-derecho {
    position: absolute;
    right: 10px;
    top: 10px;
    bottom: 10px;
    width: 360px;
}

.menu-handle {
    position: absolute;
    right: 0;
    top: 50%;
    width: 25px;
    height: 50px;
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border-light);
    border-right-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: translate, opacity;
    transition-duration: 0.4s;
}

.menu-handle:hover {
    background-color: var(--color-accent-primary);
}

.menu-handle--hidden {
    translate: 25px 0;
    opacity: 0;
}

.menu-derecho__cabecera {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-light);
    padding-bottom: 5px;
}

.menu-derecho__titulo {
    font-size: 14px;
    margin-bottom: 0;
    border-bottom-width: 0;
}

.boton-base {
    background-color: transparent;
    border-width: 2px;
    border-color: var(--color-accent-primary);
    color: var(--color-text-main);
    font-size: var(--size-body);
    letter-spacing: 2px;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
    padding: 8px 12px;
    border-radius: var(--radius-main);
    transition-property: background-color, border-color, opacity, scale, translate;
    transition-duration: 0.3s;
    cursor: pointer;
}

/* Botón cerrar (X) */
.boton-base.boton-cerrar {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-main);
    font-size: 16px;
    -unity-font-style: bold;
    padding: 5px;
}

.boton-base.boton-cerrar:hover {
    color: var(--color-accent-secondary);
}

.tooltip-panel {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 325px;
    padding: 17px;
    min-height: 600px;
    display: flex;
}

.tooltip__cabecera {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.tooltip__simbolo-box {
    width: 90px;
    height: 90px;
    justify-content: center;
    align-items: center;
    margin-right: 15px;
}

.tooltip__simbolo-texto {
    font-size: 20px;
    color: white;
}

.tooltip__nombre {
    font-size: 24px;
    margin: 0;
    margin-bottom: -2px;
    -unity-font-style: bold;
    -unity-font-definition: var(--font-secondary);
}

.tooltip__masa {
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    margin: 0;
    margin-bottom: 0;
}

.tooltip__simbolo-identidad {
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
    margin: 0;
    margin-bottom: -2px;
}

.tooltip__info-basica {
    flex-grow: 1;
}

.tooltip__subtitulo-container {
    flex-direction: row;
    align-items: center;
    margin-top: 25px;
    margin-bottom: 8px;
}

.tooltip__subtitulo {
    font-size: 13px;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
    color: var(--color-accent-primary);
    letter-spacing: 2px;
}

.tooltip__subtitulo-linea {
    flex-grow: 1;
    height: 1px;
    background-color: var(--color-accent-primary);
    margin-left: 10px;
    opacity: 0.6;
}

.tooltip__formula {
    font-size: 14px;
    margin-top: 2px;
}



/* --- Layout de Datos con Iconos --- */
.tooltip__dato-fila {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 16px;
}

.tooltip__dato-icono {
    width: 29px;
    height: 29px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-accent-primary);
    flex-shrink: 0;
}

.icono-balance {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/balance_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png");
}

.icono-ciencia {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/bubble_chart_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png");
}

.icono-composicion {
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/science_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png");
}

.tooltip__dato-dinamico {
    margin-bottom: 0;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    white-space: normal;
    flex-shrink: 1;
    opacity: var(--opacity-common);
}


.tooltip__descripcion {
    padding-top: 5px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

.tooltip__nota {
    padding-top: 5px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: var(--opacity-common);
}

/* --- Footer: Clasificación --- */
.tooltip__footer {
    flex-direction: row;
    align-items: center;
    margin-top: 15px;
    padding: 9px 15px;
    border-width: 1px;
    border-color: var(--color-accent-primary);
    background-color: transparent;
    border-radius: var(--radius-main);
}

.tooltip__footer-icono {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    background-image: url("project:/Assets/Interfaz/Iconos/decoracion/LogoSimulador_icono.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: var(--opacity-common);
}

.tooltip__footer-info {
    flex-grow: 1;
}

.tooltip__footer-titulo {
    font-size: 14px;
    color: rgb(157, 193, 215);
    opacity: 0.7;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.tooltip__footer-subtitulo {
    font-size: 14px;
    color: white;
    opacity: var(--opacity-subtle);
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
    margin-top: 5px;
}

.boton-base.boton-atomo__borrar {
    width: 26px;
    height: 26px;
    background-color: var(--color-accent-secondary);
    color: rgba(255, 255, 255, 0.8);
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--color-accent-secondary-alt);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s;
    margin-left: 10px;
}

.boton-base.boton-atomo__borrar:hover {
    background-color: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary-alt);
    color: white;
    scale: 1.15;
}

.boton-base.boton-atomo {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 50, 110, 0.1);
    padding: 12px;
    margin-bottom: 6px;
    border-left-width: 2px;
    border-left-color: transparent;
    transition-property: background-color, border-left-color, translate;
    transition-duration: 0.3s;
}

.boton-base.boton-atomo:hover {
    background-color: rgba(0, 50, 110, 0.25);
    border-left-color: var(--color-accent-primary);
    translate: 8px 0;
}

.boton-atomo__icono {
    width: 56px;
    height: 56px;
    margin-right: 15px;
    flex-shrink: 0;
}

.boton-atomo__texto {
    flex-grow: 1;
    font-size: 13px;
    letter-spacing: 1px;
    opacity: 0.8;
}

.console-label {
    margin-bottom: 4px;
    white-space: normal;
    font-size: var(--font-size-common);
    color: var(--color-text-secondary);
    opacity: 1.0;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-secondary);
}

.console-label--important {
    color: var(--color-accent-tertiary);
}

.border-light {
    position: absolute;
    border-radius: 1px;
}

/* --- MENÚ PRINCIPAL --- */
.menu-principal-pantalla {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    justify-content: center;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.boton-base.boton-ajustes {
    position: absolute;
    top: 5px;
    left: 5px;
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-width: 0;
    opacity: var(--opacity-common);
    background-image: url("project:/Assets/Interfaz/Iconos/settings_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.png");
    transition-property: opacity, rotate, scale;
    transition-duration: 0.4s;
}

.boton-base.boton-ajustes--hidden {
    opacity: 0;
    scale: 0;
}

.boton-base.boton-ajustes:hover {
    opacity: 1;
    rotate: 45deg;
    scale: 1.1;
}

.menu-principal--hidden {
    opacity: 0;
    scale: 1.1;
}

.menu-principal__contenedor {
    align-items: center;
}

.titulo-logo {
    width: 1000px;
    height: 333px;
    margin-bottom: 20px;
    background-image: url("project:/Assets/Interfaz/Iconos/LogoSimulador_medio_grande.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 2s;
    transition-timing-function: ease-out;
}

.titulo-logo--hidden {
    opacity: 0;
    scale: 0.8;
}

.cuadro-informacion {
    position: absolute;
    top: 25px;
    right: 25px;
    align-items: flex-end;
    padding-right: 15px;
    border-right-width: 2px;
    border-right-color: var(--color-accent-primary);
    transition-property: opacity;
    transition-duration: 0.8s;
}

.cuadro-informacion--hidden {
    opacity: 0;
}

.info-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 3px;
    margin-bottom: 2px;
    -unity-font-style: bold;
    -unity-font-definition: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
}

.info-label--bold {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 5px;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.boton-base.boton-iniciar {
    width: 322px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: transparent;
    border-width: 2px;
    border-color: var(--color-accent-primary);
    color: white;
    font-size: 14px;
    letter-spacing: 3px;
    transition-property: background-color, border-color, scale, translate, opacity;
    transition-duration: 0.5s;
}

.boton-base.boton-iniciar--hidden {
    opacity: 0;
    scale: 0.8;
}

.boton-base.boton-iniciar:hover {
    background-color: var(--color-border-light);
    border-color: var(--color-accent-primary);
    scale: 1.05;
    translate: 0 -5px;
}

.boton-base.boton-iniciar:active {
    scale: 0.95;
}

.boton-base.boton-salir {
    margin-top: 15px;
    border-color: var(--color-accent-secondary);
    font-size: 11px;
    letter-spacing: 2px;
    height: 40px;
}

.boton-base.boton-salir:hover {
    background-color: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary-alt);
    color: white;
}

.boton-base.boton-limpiar {
    margin-top: 10px;
    border-color: var(--color-accent-tertiary);
}

.boton-base.boton-limpiar:hover {
    background-color: var(--color-accent-tertiary);
    border-color: #ff9800;
}

.logos-contenedor {
    position: absolute;
    bottom: 10px;
    right: -20px;
    flex-direction: row;
    align-items: center;
    transition-property: opacity;
    transition-duration: 1s;
}

.logos-contenedor--hidden {
    opacity: 0;
}

.logo-icon {
    width: 100px;
    height: 50px;
    opacity: 0.5;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    -unity-background-scale-mode: scale-to-fit;
}

.logo-icon:hover {
    opacity: 1;
    scale: 1.05;
}

.logo-compania {
    background-image: url("project:/Assets/Interfaz/IMG/logo_yeiko_pequeno.png");
}

.texto-creditos {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-font-definition: url("project:/Assets/Interfaz/Fuentes/Montserrat-VariableFont_wght.ttf");
    border-left-width: 2px;
    border-left-color: var(--color-accent-primary);
    padding-left: 10px;
    transition-property: color, border-left-color, opacity;
    transition-duration: 0.3s;
}

.texto-creditos--hidden {
    opacity: 0;
}

.texto-creditos:hover {
    color: white;
    border-left-color: white;
}

/* --- NOTIFICACIÓN SUPERIOR --- */
.notificacion-panel {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 450px;
    align-items: center;
    padding: 15px 25px;
    transition-property: translate, opacity, border-color, border-bottom-color;
    transition-duration: 0.6s, 0.6s, 0.5s, 0.5s;
    transition-timing-function: ease-out-bounce, ease-out-bounce, ease-out-back, ease-out-back;
}

.notificacion--hidden {
    opacity: 0;
    translate: -50% -100px;
}

.notificacion__titulo {
    font-size: 16px;
    color: var(--color-accent-secondary-alt);
    letter-spacing: 4px;
    margin-bottom: 5px;
    transition-property: color;
    transition-duration: 0.3s;
}

.notificacion__titulo--fusion {
    color: var(--color-accent-tertiary-alt) !important;
}

.notificacion__titulo--ruptura {
    color: var(--color-accent-secondary-alt) !important;
}

.notificacion__mensaje {
    font-size: 13px;
    color: white;
    opacity: 0.8;
    white-space: normal;
    -unity-text-align: middle-center;
}